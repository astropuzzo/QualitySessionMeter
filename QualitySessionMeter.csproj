<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>NINA.Plugin.QualitySessionMeter</RootNamespace>
    <AssemblyName>QualitySessionMeter</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyTitle>QualitySessionMeter</AssemblyTitle>
    <Title>QualitySessionMeter</Title>
    <Authors>astropuzzo</Authors>
    <Company>astropuzzo</Company>
    <Product>QualitySessionMeter</Product>
    <Description>Real-time subframe quality control, session diagnostics and accepted-frame acquisition for N.I.N.A.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>1.3.0.4</Version>
    <AssemblyVersion>1.3.0.4</AssemblyVersion>
    <FileVersion>1.3.0.4</FileVersion>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <QsmDevelopmentBuild Condition="'$(QsmDevelopmentBuild)' == ''">false</QsmDevelopmentBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(QsmDevelopmentBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);QSM_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="QualitySessionMeter.SyntheticCheck\**\*.cs" />
    <None Remove="QualitySessionMeter.SyntheticCheck\**\*" />
  </ItemGroup>

  <ItemGroup Condition="'$(QsmDevelopmentBuild)' != 'true'">
    <Compile Remove="Synthetic\**\*.cs" />
    <Compile Remove="UI\SyntheticLabDockable.cs" />
    <Compile Remove="UI\SyntheticResources.xaml.cs" />
    <Page Remove="UI\SyntheticResources.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.3.0.1057-nightly" />
  </ItemGroup>
</Project>