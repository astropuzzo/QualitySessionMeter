<ResourceDictionary
    x:Class="NINA.Plugin.QualitySessionMeter.UI.OptionsHelpResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="QualitySessionMeter_Options_Polished">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Left"
                      Background="{DynamicResource BackgroundBrush}"
                      Loaded="OptionsRootLoaded">
            <StackPanel Margin="12,8,28,28"
                        Width="980"
                        HorizontalAlignment="Left"
                        ToolTipService.ShowDuration="30000"
                        ToolTipService.InitialShowDelay="450">

                <TextBlock Text="Options" FontSize="18" Margin="0,0,0,6"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,12"/>
                <TextBlock Margin="16,0,0,8" Width="910" FontSize="11" Opacity="0.76" TextWrapping="Wrap"
                           Text="Hard rejection rules and diagnostic scores are independent: Quality and Confidence describe the session but never override an enabled reject rule."/>

                <TextBlock Text="General" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6"/>

                <Grid Margin="16,5,0,5" ToolTip="Master switch. OFF stops QSM frame assessment and its optional Advanced Sequencer helpers. Web Dashboard and OpenAstro keep their own enable rules.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable QualitySessionMeter" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.Enabled}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Choose whether QSM evaluates LIGHTs produced by N.I.N.A.'s Advanced Sequencer or every saved LIGHT visible to N.I.N.A. Default: Advanced Sequencer LIGHTs.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Frames to Monitor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.MonitoringScopeIndex}" Width="300" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Advanced Sequencer LIGHTs"/>
                        <ComboBoxItem Content="All saved LIGHTs"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Safety mode. QSM still evaluates, classifies, counts and reports frames but performs no rename/move action. Recommended for first real-sky validation.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Monitor Only" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.MonitorOnly}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Maximum number of recent clean LEARNING/ACCEPTED samples retained for each target/filter/exposure/gain/binning/camera baseline. Larger is steadier but adapts more slowly.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Baseline Window" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.BaselineWindow, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames (4–50)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,10" ToolTip="Clean same-context frames required before relative star/background baselines are mature. Until then the context remains LEARNING.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum Learning Frames" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MinimumLearningFrames, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Guiding" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,3"/>
                <TextBlock Margin="16,0,0,7" Width="910" FontSize="11" Opacity="0.74" TextWrapping="Wrap"
                           Text="QSM evaluates guide samples captured during the exposure. RMS measures overall guide error; excursion rules catch persistent or severe departures."/>

                <Grid Margin="16,5,0,5" ToolTip="Hard rejection rule using RMS calculated only from guide samples inside the camera exposure interval. This is not the dashboard rolling 20-second diagnostic RMS.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject on Exposure RMS" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableGuideRms}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Maximum allowed exposure-specific total guide RMS. When the rule is enabled, exceeding this limit rejects the frame. Lower is stricter.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Max Exposure Guide RMS" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxGuideRms, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Rejects prolonged total guide-error excursions. A single short spike does not satisfy this duration rule.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Sustained Excursion" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableSustainedExcursion}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Total guide-error magnitude that starts the sustained-excursion timer. The excursion must also last for Minimum Excursion Duration.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Excursion Threshold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionThreshold, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Continuous time above Excursion Threshold required before the sustained-excursion rule fails. Higher values tolerate short disturbances longer.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum Excursion Duration" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionMinimumDuration, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Emergency peak-error rule. A sufficiently large instantaneous total guide error can reject a frame even when it is too brief for the sustained-duration rule.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Hard Excursion" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableHardExcursion}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,10" ToolTip="Instantaneous total guide-error magnitude used by the hard excursion rule. It is always at least the normal Excursion Threshold.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Hard Excursion" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.HardExcursionThreshold, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Image Signal" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,3"/>
                <TextBlock Margin="16,0,0,7" Width="910" FontSize="11" Opacity="0.74" TextWrapping="Wrap"
                           Text="Stars and background are compared with the rolling clean baseline for the same target, filter, exposure, gain, binning and camera."/>

                <Grid Margin="16,5,0,5" ToolTip="Hard rejection rule comparing detected star count with the mature rolling baseline. QSM does not use HFR/FWHM/eccentricity alone as hard rejection criteria.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Relative Star Loss" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableStarCount}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Maximum allowed loss of detected stars relative to the mature same-context baseline. Lower is stricter.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Star Loss" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxStarLossPercent, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Hard rejection rule comparing image-background median with the mature same-context baseline. Brightening and darkening are evaluated independently.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Background Deviation" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableBackground}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Maximum allowed positive background change relative to the mature baseline.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Background Increase" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundIncreasePercent, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,10" ToolTip="Maximum allowed negative background change relative to the mature baseline.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Background Decrease" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundDecreasePercent, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Adaptive Calibration" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,3"/>
                <TextBlock Margin="16,0,0,7" Width="910" FontSize="11" Opacity="0.74" TextWrapping="Wrap"
                           Text="Optional threshold assistance learned only from stable, high-quality ACCEPTED frames in the same imaging context."/>

                <Grid Margin="16,5,0,5" ToolTip="Off leaves thresholds fully manual. Suggest Only calculates a bounded proposal for you to approve in QSM Control Center. Automatic applies one bounded proposal per context, limited by the safety caps below.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Calibration Mode" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.AdaptiveThresholdModeIndex}" Width="300" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Off"/>
                        <ComboBoxItem Content="Suggest Only (recommended)"/>
                        <ComboBoxItem Content="Automatic"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Stable ACCEPTED same-context frames required before a calibration proposal becomes available.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Stable Calibration Window" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.CalibrationWindow, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="accepted frames (8–50)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Margin="16,7,0,4" Width="910" FontSize="11" FontWeight="SemiBold" Opacity="0.78" TextWrapping="Wrap"
                           Text="Automatic safety caps limit what Automatic calibration may set; they are not rejection thresholds."/>

                <Grid Margin="16,4,0,4" ToolTip="Upper safety cap for an automatically generated Max Exposure Guide RMS suggestion.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max RMS" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxGuideRms, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="16,4,0,4" ToolTip="Upper safety cap for an automatically generated sustained Excursion Threshold.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Excursion" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxExcursion, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="16,4,0,4" ToolTip="Upper safety cap for an automatically generated Hard Excursion threshold.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Hard Excursion" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxHardExcursion, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="16,4,0,4" ToolTip="Upper safety cap for an automatically generated Maximum Star Loss suggestion.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Star Loss" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxStarLossPercent, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="16,4,0,10" ToolTip="Upper safety cap shared by automatically generated background increase/decrease suggestions.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Background" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxBackgroundPercent, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Quality &amp; Session Intelligence" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6"/>

                <Grid Margin="16,5,0,5" ToolTip="Controls only the displayed Overall Quality score: worst channel × weight + average × (1 − weight). Hard rejection rules are independent.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Worst-channel Influence" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.WorstMetricWeight, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="0.50–0.95" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Filesystem action attempted only for an eligible REJECTED frame when Monitor Only is OFF. QSM never deletes an image and all rename/move actions are collision-safe.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Rejected File Action" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.RejectedFileActionIndex}" Width="300" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Keep in Place"/>
                        <ComboBoxItem Content="Prefix BAD_"/>
                        <ComboBoxItem Content="Move to Rejected Folder"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Advisory early-warning diagnostics based on recent measured trends. Predictive warnings do not reject a frame by themselves.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Predictive Warnings" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.PredictiveWarningsEnabled}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,10" ToolTip="Records available N.I.N.A. weather/environment data and may add explanatory correlation hints. Weather data never independently rejects a frame.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Use Environmental Data for Hints" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnvironmentalCorrelationEnabled}" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock Text="Smart Recovery (Advanced Sequencer)" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,3"/>
                <TextBlock Margin="16,0,0,7" Width="910" FontSize="11" Opacity="0.74" TextWrapping="Wrap"
                           Text="Optional sequence helper. Place QSM Smart Recovery Gate after Take Exposure; it only waits between exposures and never aborts one already in progress."/>

                <Grid Margin="16,5,0,5" ToolTip="Enables the optional QSM Smart Recovery Gate. After a configured streak of REJECTED/ERROR results it waits, checks guide recovery when possible, then permits the next probe exposure.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable Smart Recovery Gate" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.SmartPauseEnabled}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Consecutive REJECTED or ERROR results associated with the sequence loop required before Smart Recovery activates. ACCEPTED/WARNING results break the streak.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject / Error Streak" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartPauseRejectStreak, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames (2–10)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Cooldown inserted between exposures after persistent degradation.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Recovery Wait" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartPauseSeconds, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="seconds (10–1800)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,10" ToolTip="Healthy guide samples required after cooldown before reporting recovery. If recovery cannot be confirmed before the safety timeout, QSM permits one probe exposure instead of waiting forever.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Healthy Guide Samples to Resume" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartResumeHealthyGuideChecks, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="samples (1–10)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Web Dashboard" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,3"/>
                <TextBlock Margin="16,0,0,7" Width="910" FontSize="11" Opacity="0.74" TextWrapping="Wrap"
                           Text="Optional read-only browser dashboard for LAN/VPN monitoring. QSM does not open router ports or create an Internet tunnel."/>

                <Grid Margin="16,5,0,5" ToolTip="Starts QSM's self-contained read-only HTTP dashboard on this N.I.N.A. computer.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable Web Dashboard" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardEnabled}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="TCP port used by the local dashboard. Changing it restarts the listener. OpenAstro keeps its separate port/token configuration.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Port" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.WebDashboardPort, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="default 18974" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Preferred physical-LAN URL detected for this N.I.N.A. PC. The convenience address ignores common VPN/tunnel/virtual adapters.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Dashboard Address" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding WebDashboardAddress, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Width="410" HorizontalAlignment="Left"/>
                    <Button Grid.Column="2" Content="Copy" Click="CopyDashboardAddress" Width="72" HorizontalAlignment="Left" Margin="8,0,0,0" ToolTip="Copy the complete dashboard URL to the Windows clipboard."/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Current local dashboard listener state. Startup errors are reported here.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Status" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding WebDashboardStatus}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="16,5,0,5" ToolTip="Optional browser login. OFF allows direct access to clients that can reach the listener. ON requires the configured password. Plain HTTP remains unencrypted; direct public-Internet exposure is unsupported.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Require Password" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardRequirePassword}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="16,5,0,10" ToolTip="Type a new password and leave the field to store it. QSM stores only a random salt and PBKDF2-HMAC-SHA256 hash. Changing or clearing it invalidates existing browser sessions.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Password" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" Width="300" HorizontalAlignment="Left" LostKeyboardFocus="DashboardPasswordLostFocus"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Settings.WebDashboardPasswordStatus}" VerticalAlignment="Center" Opacity="0.72" Margin="8,0,8,0"/>
                        <Button Content="Clear" Click="ClearDashboardPassword" Width="64"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Description" FontSize="18" Margin="0,20,0,5"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="16,0,0,0" Width="910" TextWrapping="Wrap"
                           Text="QualitySessionMeter evaluates LIGHT frames using exposure-specific guiding, rolling same-context star/background baselines, temporal session intelligence and explicit hard rejection rules. Rejected images are never deleted."/>

                <TextBlock Text="Features" FontSize="18" Margin="0,16,0,5"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="16,0,0,0" Width="910" TextWrapping="Wrap"
                           Text="• Quality and independent Confidence scores&#x0a;• Exposure guide RMS plus sustained/hard excursion rules&#x0a;• Rolling star/background baselines&#x0a;• Reversible rejected-file handling&#x0a;• Session events, predictive diagnostics and reports&#x0a;• Valid Frame Target and optional Smart Recovery integration&#x0a;• Read-only local Web Dashboard&#x0a;• Separate tokenized OpenAstro companion API"/>

                <TextBlock Text="Getting Help" FontSize="18" Margin="0,16,0,5"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="16,0,0,0" Width="910" TextWrapping="Wrap"
                           Text="Repository, documentation and issue tracker: github.com/astropuzzo/QualitySessionMeter"/>
                <TextBlock Margin="16,5,0,0" Width="910" FontSize="11" Opacity="0.72" TextWrapping="Wrap"
                           Text="See docs/SETTINGS.md for detailed option help, docs/METRICS.md for metric definitions and SECURITY.md for the Web Dashboard security model."/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
