<ResourceDictionary
    x:Class="NINA.Plugin.QualitySessionMeter.UI.OptionsHelpResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="QsmOptHint" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.68"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <DataTemplate x:Key="QualitySessionMeter_Options_Polished">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" MaxWidth="760" ToolTipService.ShowDuration="30000">
                <TextBlock Text="Quality Session Meter" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Real-time frame quality control. Rejected files are never deleted." Opacity="0.72"/>
                <TextBlock Text="Hover any label, switch or value for a detailed explanation." Opacity="0.58" FontSize="11" Margin="0,3,0,16"/>

                <GroupBox Header="General" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid ToolTip="Master switch. OFF means QSM does not analyze LIGHT frames, update QSM counters, run rejected-file actions, or allow QSM sequence-control blocks to operate.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Enable QualitySessionMeter" FontWeight="SemiBold"/>
                                <TextBlock Text="Master ON/OFF switch." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.Enabled}" VerticalAlignment="Center" Margin="18,0,0,0"
                                      ToolTip="ON enables QSM for eligible LIGHT frames. OFF disables both analysis and V3 sequence control."/>
                        </Grid>

                        <Border Height="1" Opacity="0.15" Background="White" Margin="0,9"/>

                        <Grid ToolTip="Safety mode. When enabled, QSM still measures, classifies, counts and reports frames, but it suppresses every rename/move action. Recommended for first-sky validation and troubleshooting.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Monitor only" FontWeight="SemiBold"/>
                                <TextBlock Text="Analyze and report without changing image files." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.MonitorOnly}" VerticalAlignment="Center" Margin="18,0,0,0"
                                      ToolTip="Keep ON until you intentionally want rejected-file handling. With Monitor only ON, Prefix BAD_ / Move to Rejected are not executed."/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Baseline window (good frames)" VerticalAlignment="Center"
                                       ToolTip="Maximum number of recent clean accepted/learning frames retained in each imaging-context baseline bucket. The bucket is separated by target, filter, exposure, gain, binning and camera. Larger windows are more stable but react more slowly."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.BaselineWindow, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Rolling baseline capacity for clean frames in the same imaging context."/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Minimum learning frames" VerticalAlignment="Center"
                                       ToolTip="How many clean same-context samples QSM needs before relative star/background thresholds are considered mature. During LEARNING, relative image-signal evidence is not treated as fully mature and V3 Valid Frame Target does not count LEARNING as valid by default."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.MinimumLearningFrames, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Minimum clean samples required before the adaptive baseline becomes mature."/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Guiding" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid ToolTip="Rejects a frame when the RMS of guide samples belonging to that exposure exceeds the configured maximum. Use a threshold appropriate for your image scale and normal mount performance.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reject on exposure RMS" FontWeight="SemiBold"/>
                                <TextBlock Text="Hard rule based on exposure-specific guiding RMS." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableGuideRms}" VerticalAlignment="Center" Margin="18,0,0,0"
                                      ToolTip="ON: GUIDE_RMS can reject a frame when exposure RMS exceeds Maximum RMS."/>
                        </Grid>
                        <Grid Margin="20,7,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum RMS (arcsec)" VerticalAlignment="Center"
                                       ToolTip="Maximum allowed guide RMS during the exposure. Lower is stricter. Set this from known-good real guiding, not from an arbitrary universal value."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.MaxGuideRms, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Frames with higher exposure RMS are rejected when the RMS rule is enabled."/>
                        </Grid>

                        <Grid ToolTip="Rejects a frame only when guide error stays above the excursion threshold for at least the configured continuous duration. A single isolated spike is deliberately not treated as sustained excursion.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reject sustained guide excursion" FontWeight="SemiBold"/>
                                <TextBlock Text="Detects prolonged tracking disturbance, not one isolated spike." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableSustainedExcursion}" VerticalAlignment="Center" Margin="18,0,0,0"
                                      ToolTip="ON: sustained above-threshold guide error can reject the frame."/>
                        </Grid>
                        <Grid Margin="20,7,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Excursion threshold (arcsec)" VerticalAlignment="Center"
                                       ToolTip="Guide-error magnitude that begins the sustained-excursion timer. This is not itself enough to reject; the error must remain above it for the minimum duration."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionThreshold, UpdateSourceTrigger=LostFocus}" ToolTip="Arcsecond threshold used by sustained-excursion analysis."/>
                        </Grid>
                        <Grid Margin="20,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Minimum duration (seconds)" VerticalAlignment="Center"
                                       ToolTip="Continuous time above the excursion threshold required before the sustained-excursion rule rejects the frame. Longer values ignore short disturbances more aggressively."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionMinimumDuration, UpdateSourceTrigger=LostFocus}" ToolTip="Required continuous excursion duration in seconds."/>
                        </Grid>

                        <Grid ToolTip="Emergency hard limit. If any guide sample reaches this excursion magnitude, the frame can be rejected even when the disturbance was too short to satisfy the sustained-duration rule.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reject hard guide excursion" FontWeight="SemiBold"/>
                                <TextBlock Text="Catches very large instantaneous tracking errors." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableHardExcursion}" VerticalAlignment="Center" Margin="18,0,0,0"
                                      ToolTip="ON: one sufficiently large guide excursion can reject the frame."/>
                        </Grid>
                        <Grid Margin="20,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Hard excursion (arcsec)" VerticalAlignment="Center"
                                       ToolTip="Absolute guide-error limit for the hard-excursion rule. It must remain at or above the normal excursion threshold."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.HardExcursionThreshold, UpdateSourceTrigger=LostFocus}" ToolTip="Instantaneous excursion limit in arcseconds."/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Image signal" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid ToolTip="Compares detected star count with the mature rolling baseline for the same imaging context. A sufficiently large relative loss can indicate clouds, transparency loss or severe image degradation. It does not use HFR/FWHM/eccentricity for the hard decision.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reject relative star-count loss" FontWeight="SemiBold"/>
                                <TextBlock Text="Relative transparency/signal rule using the same-context baseline." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableStarCount}" VerticalAlignment="Center" Margin="18,0,0,0"
                                      ToolTip="ON: a mature-baseline star-count drop beyond the configured percentage can reject the frame."/>
                        </Grid>
                        <Grid Margin="20,7,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum star loss (%)" VerticalAlignment="Center"
                                       ToolTip="Largest allowed percentage drop in detected stars relative to the mature same-context baseline. Lower is stricter; too low can overreact to normal detection scatter."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.MaxStarLossPercent, UpdateSourceTrigger=LostFocus}" ToolTip="Maximum allowed relative star-count loss percentage."/>
                        </Grid>

                        <Grid ToolTip="Compares image background median with the mature same-context baseline. Large increases may indicate haze, moonlight/cloud glow or light contamination; large decreases may indicate abnormal signal loss. QSM treats this as a measured hard rule when enabled.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Reject background deviation" FontWeight="SemiBold"/>
                                <TextBlock Text="Rejects large relative background changes from the clean baseline." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableBackground}" VerticalAlignment="Center" Margin="18,0,0,0"
                                      ToolTip="ON: excessive background increase or decrease can reject the frame once the baseline is mature."/>
                        </Grid>
                        <Grid Margin="20,7,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum increase (%)" VerticalAlignment="Center" ToolTip="Maximum allowed percentage increase in background median relative to the same-context baseline."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundIncreasePercent, UpdateSourceTrigger=LostFocus}" ToolTip="Background-high rejection threshold in percent."/>
                        </Grid>
                        <Grid Margin="20,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Maximum decrease (%)" VerticalAlignment="Center" ToolTip="Maximum allowed percentage decrease in background median relative to the same-context baseline."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundDecreasePercent, UpdateSourceTrigger=LostFocus}" ToolTip="Background-low rejection threshold in percent."/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Quality score &amp; rejected files" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Worst-metric weight (0.50–0.95)" VerticalAlignment="Center"
                                       ToolTip="Controls the displayed 0–100 Quality Score only: how strongly the worst sub-score dominates the combined score. This does NOT replace or weaken hard rejection rules; a frame can have a reasonable score and still be REJECTED if any enabled hard rule fails."/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.WorstMetricWeight, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Higher values make the displayed Quality Score more dominated by the weakest measured channel. Hard ACCEPT/REJECT remains independent."/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Rejected file action" VerticalAlignment="Center"
                                       ToolTip="What QSM should do with a safely provenance-scoped rejected LIGHT when Monitor only is OFF. QSM never deletes images. Manual/unknown frames are protected from mutation by the V3 source gate."/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.RejectedFileActionIndex}"
                                      ToolTip="Keep in place leaves the filename unchanged. Prefix BAD_ renames the file. Move to Rejected places it in a Rejected subfolder. None of these run while Monitor only is ON.">
                                <ComboBoxItem Content="Keep in place" ToolTip="Record the rejection but leave the image exactly where it was saved."/>
                                <ComboBoxItem Content="Prefix BAD_" ToolTip="Rename an eligible rejected file by adding BAD_ to its filename. Collision-safe; never deletes the original content."/>
                                <ComboBoxItem Content="Move to Rejected subfolder" ToolTip="Move an eligible rejected file into a Rejected subfolder beside the acquisition folder. Collision-safe; never deletes the image."/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Margin="0,9,0,0" Style="{StaticResource QsmOptHint}" Text="Safety: QSM never deletes frames. File actions require Monitor only OFF and eligible V3 acquisition provenance."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Web Dashboard" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid ToolTip="Starts a self-contained, read-only QSM dashboard on this N.I.N.A. computer. Open the shown address from a phone, tablet or another computer that can reach this machine over LAN or VPN.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Enable Web Dashboard" FontWeight="SemiBold"/>
                                <TextBlock Text="Serve the QSM mobile dashboard directly from this PC." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardEnabled}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Port" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding Settings.WebDashboardPort, UpdateSourceTrigger=LostFocus}" ToolTip="Local TCP port used by the browser dashboard. Default: 18974."/>
                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource QsmOptHint}" Text="Default 18974"/>
                        </Grid>

                        <Border Height="1" Opacity="0.15" Background="White" Margin="0,12"/>

                        <Grid ToolTip="Optional. Leave this OFF for one-tap access on your own LAN/VPN. Turn it ON only if you want the dashboard itself to require a password.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Require password" FontWeight="SemiBold"/>
                                <TextBlock Text="Optional login for the browser dashboard." Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardRequirePassword}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Set / replace password"/>
                                <TextBlock Text="{Binding Settings.WebDashboardPasswordStatus}" Style="{StaticResource QsmOptHint}"/>
                            </StackPanel>
                            <PasswordBox Grid.Column="1" IsEnabled="{Binding Settings.WebDashboardRequirePassword}"
                                         LostKeyboardFocus="DashboardPasswordLostFocus"
                                         ToolTip="Type a new password, then leave this field. QSM stores only a salted PBKDF2 hash, not the clear-text password."/>
                            <Button Grid.Column="2" Margin="8,0,0,0" Padding="10,4" Content="Clear saved password"
                                    IsEnabled="{Binding Settings.WebDashboardPasswordConfigured}"
                                    Click="ClearDashboardPassword"/>
                        </Grid>

                        <Border Height="1" Opacity="0.15" Background="White" Margin="0,12"/>

                        <TextBlock Text="Dashboard address" FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WebDashboardAddress}" IsReadOnly="True" FontFamily="Consolas"
                                     VerticalContentAlignment="Center" ToolTip="The preferred physical LAN address detected for this N.I.N.A. PC. You can also select and copy it manually."/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Content="Copy address"
                                    Click="CopyDashboardAddress" ToolTip="Copy the complete dashboard URL to the Windows clipboard."/>
                        </Grid>
                        <TextBlock Text="{Binding WebDashboardStatus, StringFormat=Status: {0}}" Margin="0,3,0,0" Style="{StaticResource QsmOptHint}"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource QsmOptHint}" Text="QSM prefers the physical Ethernet/Wi-Fi LAN address for this link and ignores common VPN/virtual adapters. The dashboard is read-only. QSM does not open router ports or expose itself to the Internet. For access away from home, use your existing VPN/reverse-proxy setup. The existing tokenized OpenAstro API remains separate and unchanged."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>