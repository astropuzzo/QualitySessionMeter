<ResourceDictionary
    x:Class="NINA.Plugin.QualitySessionMeter.UI.OptionsHelpResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="QualitySessionMeter_Options_Polished">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Left"
                      Background="{DynamicResource BackgroundBrush}"
                      Loaded="OptionsRootLoaded">
            <StackPanel Margin="8,4,24,22"
                        Width="920"
                        HorizontalAlignment="Left"
                        ToolTipService.ShowDuration="30000"
                        ToolTipService.InitialShowDelay="300">

                <TextBlock Text="Options" FontSize="18" FontWeight="Normal" TextAlignment="Left" Margin="0,2,0,5"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,8"/>
                <TextBlock Margin="14,0,0,10" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="QSM separates hard rejection rules from diagnostic scores. A hard rule rejects only when that rule is enabled and its measured limit is exceeded. Quality/Confidence help interpret the session but never override a hard rejection."/>

                <TextBlock Text="General" FontWeight="SemiBold" TextAlignment="Left"/>
                <Grid Margin="14,2,0,2" ToolTip="Master switch. OFF means QSM does not analyze eligible LIGHT frames and QSM Advanced Sequencer control is inactive. The browser/OpenAstro monitoring services keep their own enable rules.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable QualitySessionMeter" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.Enabled}" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="14,2,0,2" ToolTip="Selects which saved LIGHT frames are eligible for QSM assessment. File mutation remains separately provenance-gated and is never inferred only from filename or extension.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Frames to Monitor" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.MonitoringScopeIndex}" Width="285" HorizontalAlignment="Left">
                        <ComboBoxItem Content="QSM-controlled blocks only (safest)"/>
                        <ComboBoxItem Content="All Advanced Sequencer LIGHTs"/>
                        <ComboBoxItem Content="All saved LIGHTs (widest)"/>
                    </ComboBox>
                </Grid>
                <TextBlock Margin="28,0,0,7" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="QSM-controlled blocks only = only frames from loops explicitly controlled by QSM.  Advanced Sequencer LIGHTs = every LIGHT produced by N.I.N.A.'s Advanced Sequencer.  All saved LIGHTs = also manual/external LIGHT saves.  This setting decides what QSM analyses; file rename/move safety is checked separately."/>

                <Grid Margin="14,2,0,2" ToolTip="Safety mode. QSM still evaluates, classifies, counts and reports frames, but suppresses QSM rename/move actions. Recommended for first real-sky tests.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Monitor Only" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.MonitorOnly}" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Margin="28,0,0,7" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="ON = QSM can mark a frame REJECTED but never renames or moves its file.  OFF = the Rejected File Action below may run for eligible rejected frames."/>

                <Grid Margin="14,2,0,2" ToolTip="Maximum number of recent clean LEARNING/ACCEPTED samples retained for each independent target/filter/exposure/gain/binning/camera baseline. Larger is steadier but adapts more slowly.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Baseline Window" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.BaselineWindow, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames (4–50)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,8" ToolTip="Number of clean same-context samples required before star/background baselines are mature. Until then the context remains LEARNING.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum Learning Frames" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MinimumLearningFrames, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Guiding" FontWeight="SemiBold" TextAlignment="Left"/>
                <TextBlock Margin="14,0,0,5" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="QSM evaluates guide samples that occurred during the camera exposure. RMS measures the overall spread of guiding error; excursion rules catch large or persistent departures that an average RMS can hide."/>
                <Grid Margin="14,2,0,2" ToolTip="Hard rejection rule using RMS calculated only from guide samples whose timestamps fall inside the exposure interval. This is not the dashboard rolling 20-second RMS diagnostic.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject on Exposure RMS" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableGuideRms}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Maximum allowed exposure-specific total guide RMS. When the rule above is enabled, a completed exposure whose RMS exceeds this value is REJECTED. Lower is stricter.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Max Exposure Guide RMS" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxGuideRms, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <TextBlock Margin="28,0,0,6" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="Example: with 1.60 arcsec configured, an exposure measured at 1.72 arcsec fails the RMS hard rule. A 0.45 arcsec live dashboard RMS does not guarantee the finished exposure RMS will be 0.45 arcsec; they use different time windows."/>

                <Grid Margin="14,2,0,2" ToolTip="Hard rejection rule for prolonged total guide-error magnitude. A single isolated spike does not satisfy the duration rule.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Sustained Excursion" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableSustainedExcursion}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Total guide-error magnitude that starts the sustained-excursion timer. Crossing it alone is not enough: the excursion must also last for Minimum Excursion Duration.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Excursion Threshold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionThreshold, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Continuous time above Excursion Threshold required by the sustained-excursion hard rule. Higher values ignore short disturbances more aggressively.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum Excursion Duration" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionMinimumDuration, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Emergency hard rejection rule. A sufficiently large instantaneous total guide error can reject a frame even if it is too brief for the sustained-duration rule.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Hard Excursion" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableHardExcursion}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,8" ToolTip="Instantaneous total guide-error magnitude for the hard excursion rule. It is always at least the normal Excursion Threshold.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Hard Excursion" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.HardExcursionThreshold, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Image Signal" FontWeight="SemiBold" TextAlignment="Left"/>
                <TextBlock Margin="14,0,0,5" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="Star count and background are compared with a rolling clean baseline for the same target, filter, exposure, gain, binning and camera. Warning/rejected/error frames never teach the baseline."/>
                <Grid Margin="14,2,0,2" ToolTip="Hard rejection rule comparing detected star count with the mature rolling clean-frame baseline. QSM does not use HFR/FWHM/eccentricity as hard rejection criteria in this release.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Relative Star Loss" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableStarCount}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Maximum allowed drop in detected stars relative to the mature same-context baseline. Example: -40% with a 35% limit fails this rule.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Star Loss" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxStarLossPercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Hard rejection rule comparing image background median with the mature same-context rolling baseline. Excessive brightening and darkening are evaluated independently.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Background Deviation" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableBackground}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Maximum allowed positive background change relative to the mature baseline. Brightening can accompany illuminated cloud, haze, moonlight or other sky changes; the reject test itself is numerical.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Background Increase" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundIncreasePercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,8" ToolTip="Maximum allowed negative background change relative to the mature baseline. Probable-cause text is diagnostic; the hard decision uses the measured deviation.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Background Decrease" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundDecreasePercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Adaptive Calibration" FontWeight="SemiBold" TextAlignment="Left"/>
                <TextBlock Margin="14,0,0,5" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="Optional threshold assistance learned only from stable, high-quality ACCEPTED frames in the same imaging context. It never learns from rejected/warning frames."/>
                <Grid Margin="14,2,0,2" ToolTip="Off disables calibration help. Suggest Only generates a bounded recommendation and waits for you to apply it from QSM Control Center. Automatic applies one available bounded recommendation for that imaging context. Safety caps below limit how far Automatic may loosen thresholds.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Calibration Mode" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.AdaptiveThresholdModeIndex}" Width="285" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Off — no calibration help"/>
                        <ComboBoxItem Content="Suggest Only — you approve changes"/>
                        <ComboBoxItem Content="Automatic — apply bounded suggestion"/>
                    </ComboBox>
                </Grid>
                <TextBlock Margin="28,0,0,7" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="Suggest Only (recommended): QSM calculates proposed limits and shows them in QSM Control Center; nothing changes until you press Apply suggestion.  Automatic: when enough stable samples exist, QSM applies a proposal automatically, but never beyond the safety caps below.  Off: current thresholds remain entirely manual."/>
                <Grid Margin="14,2,0,2" ToolTip="Number of stable ACCEPTED frames required before a calibration suggestion becomes available. Stable frames are same-context, Quality at least 80 and Confidence at least 70 when confidence is finite.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Stable Calibration Window" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.CalibrationWindow, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="accepted frames (8–50)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <TextBlock Margin="14,7,0,3" Width="850" HorizontalAlignment="Left" Opacity="0.72" FontSize="11" TextWrapping="Wrap" TextAlignment="Left"
                           Text="Automatic safety caps are not rejection thresholds. They are maximum values the automatic calibrator is allowed to propose/apply."/>
                <Grid Margin="14,2,0,2" ToolTip="Upper safety cap for an automatically generated Max Exposure Guide RMS suggestion.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max RMS" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxGuideRms, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Upper safety cap for an automatically generated sustained Excursion Threshold.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Excursion" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxExcursion, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Upper safety cap for an automatically generated Hard Excursion threshold.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Hard Excursion" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxHardExcursion, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Upper safety cap for an automatically generated Maximum Star Loss suggestion.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Star Loss" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxStarLossPercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,8" ToolTip="Upper safety cap shared by automatically generated background increase/decrease suggestions.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Safety: Max Background" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.AutoSafetyMaxBackgroundPercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Quality &amp; Session Intelligence" FontWeight="SemiBold" TextAlignment="Left"/>
                <Grid Margin="14,2,0,2" ToolTip="Controls how strongly the worst available sub-score influences displayed Overall Quality. Formula: Quality = worst × weight + average × (1 − weight). It changes the diagnostic Quality score only; hard reject rules are independent.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Worst-channel influence" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.WorstMetricWeight, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="0.50–0.95" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <TextBlock Margin="28,0,0,7" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="0.70 means: 70% of the displayed Quality score comes from the worst available channel and 30% from the average of all available channels. Higher = one weak channel drags Quality down more strongly. This setting never changes whether a hard rule rejects the frame."/>

                <Grid Margin="14,2,0,2" ToolTip="Filesystem action attempted only for an eligible REJECTED frame when Monitor Only is OFF. QSM never deletes an image and all actions are collision-safe.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Rejected File Action" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.RejectedFileActionIndex}" Width="285" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Keep in Place"/>
                        <ComboBoxItem Content="Prefix BAD_"/>
                        <ComboBoxItem Content="Move to Rejected Folder"/>
                    </ComboBox>
                </Grid>
                <TextBlock Margin="28,0,0,7" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="This is ignored while Monitor Only is ON. Keep in Place leaves the file untouched; Prefix BAD_ renames it; Move to Rejected Folder moves it to a sibling Rejected folder. QSM never deletes rejected images."/>

                <Grid Margin="14,2,0,2" ToolTip="Conservative early-warning diagnostics based on recent measured trends. Advisory only: predictive warnings do not reject a frame by themselves.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Predictive Warnings" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.PredictiveWarningsEnabled}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="When N.I.N.A. has connected weather/environment data, QSM records it and may add a diagnostic correlation hint. Environment data is explanatory only and is not an independent hard rejection rule.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Use environmental data for hints" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnvironmentalCorrelationEnabled}" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Margin="28,0,0,8" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="If a N.I.N.A. weather/environment source is connected, QSM records available cloud cover, humidity, wind, sky quality, temperature and dew point and may add explanatory hints such as wind ↔ guiding disturbance or high humidity ↔ haze. It never rejects a frame solely because of weather data."/>

                <TextBlock Text="Smart Recovery (Advanced Sequencer)" FontWeight="SemiBold" TextAlignment="Left"/>
                <TextBlock Margin="14,0,0,5" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="This section has an effect only when the QSM Smart Recovery Gate sequence item is placed after Take Exposure inside a QSM-controlled loop. It never aborts an exposure already in progress."/>
                <Grid Margin="14,2,0,2" ToolTip="Enables behavior used by the optional QSM Smart Recovery Gate. After persistent controlled REJECTED/ERROR results it waits between exposures, checks guide recovery when guide rules are active, then allows the next probe exposure.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable Smart Recovery Gate" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.SmartPauseEnabled}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Consecutive QSM-controlled REJECTED or ERROR results required before the recovery gate activates. ACCEPTED/WARNING results break the streak.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject / Error Streak" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartPauseRejectStreak, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="controlled frames (2–10)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Cooldown inserted after persistent degradation. The wait happens between exposures, never during an active exposure.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Recovery Wait" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartPauseSeconds, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="seconds (10–1800)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Consecutive healthy guide samples required after cooldown before reporting RECOVERED. If a reliable recovery signal does not arrive before the safety timeout, QSM allows one probe exposure instead of waiting forever.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Healthy Guide Samples to Resume" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartResumeHealthyGuideChecks, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="samples (1–10)" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <TextBlock Margin="28,0,0,8" Width="850" HorizontalAlignment="Left" FontSize="11" Opacity="0.76" TextWrapping="Wrap" TextAlignment="Left"
                           Text="Example: streak 3 / wait 120 s / healthy samples 3 = after three consecutive controlled REJECTED/ERROR frames, the gate waits 120 seconds, then waits for three consecutive healthy guide samples before the next exposure. If guide recovery cannot be confirmed before the safety timeout, it deliberately allows one probe exposure rather than blocking the sequence forever."/>

                <TextBlock Text="Web Dashboard" FontWeight="SemiBold" TextAlignment="Left"/>
                <Grid Margin="14,2,0,2" ToolTip="Starts QSM's self-contained read-only HTTP dashboard on this N.I.N.A. computer. QSM does not configure UPnP, router forwarding, DNS or outbound tunnels.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable Web Dashboard" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardEnabled}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="TCP port used by the local browser dashboard. Changing it restarts the listener. The separate OpenAstro integration bridge keeps its own port/token configuration.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Port" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.WebDashboardPort, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="default 18974" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Preferred physical-LAN URL detected for this N.I.N.A. PC. QSM prioritizes active Ethernet/Wi-Fi private IPv4 interfaces and ignores common VPN/virtual adapters for the displayed convenience link.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Dashboard Address" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding WebDashboardAddress, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Width="400" HorizontalAlignment="Left"/>
                    <Button Grid.Column="2" Content="Copy" Click="CopyDashboardAddress" Width="72" HorizontalAlignment="Left" Margin="8,0,0,0" ToolTip="Copy the complete dashboard URL to the Windows clipboard."/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Runtime state of the local dashboard listener. Startup errors are shown here.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Status" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding WebDashboardStatus}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Optional browser login. OFF gives direct dashboard access to clients that can reach the listener. ON requires the configured password. Plain HTTP is still unencrypted; public Internet exposure is not supported.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Require Password" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardRequirePassword}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Margin="14,2,0,2" ToolTip="Type a new password and leave the field to store it. QSM stores a random salt plus PBKDF2-HMAC-SHA256 derived hash, never the clear-text password. Changing/clearing it invalidates existing browser sessions.">
