                           Text="The dashboard is read-only. Password protection is optional. QSM never opens router ports. For access away from home use your existing VPN or an HTTPS reverse proxy. The tokenized OpenAstro companion API remains separate and backward-compatible."/>

                <TextBlock Text="Description" FontSize="18" FontWeight="Normal" TextAlignment="Left"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="14,0,0,0" Width="850" HorizontalAlignment="Left" TextWrapping="Wrap" TextAlignment="Left"
                           Text="QualitySessionMeter evaluates eligible LIGHT frames using exposure-specific guiding, rolling same-context star/background baselines, temporal session intelligence and explicit hard rejection rules. Quality and Confidence are diagnostic scores; ACCEPT/REJECT remains rule-driven. Rejected images are never deleted."/>

                <TextBlock Text="Features" FontSize="18" FontWeight="Normal" TextAlignment="Left" Margin="0,10,0,0"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="14,0,0,0" Width="850" HorizontalAlignment="Left" TextWrapping="Wrap" TextAlignment="Left"
                           Text="• Real-time Quality and independent Confidence scores&#x0a;• Exposure-specific guide RMS plus sustained/hard excursion rules&#x0a;• Rolling same-context star/background baselines&#x0a;• Reversible rejected-file handling with provenance safety&#x0a;• Session events, predictive diagnostics, environmental hints and reports&#x0a;• Valid Frame Target and optional Smart Recovery Advanced Sequencer integration&#x0a;• Read-only local Web Dashboard for phone/tablet monitoring&#x0a;• Separate tokenized OpenAstro companion API"/>

                <TextBlock Text="Getting Help" FontSize="18" FontWeight="Normal" TextAlignment="Left" Margin="0,10,0,0"/>
