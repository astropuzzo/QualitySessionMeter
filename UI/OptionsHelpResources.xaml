<ResourceDictionary
    x:Class="NINA.Plugin.QualitySessionMeter.UI.OptionsHelpResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="QsmSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="0,20,0,6"/>
    </Style>

    <Style x:Key="QsmSubHeader" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="14,12,0,5"/>
    </Style>

    <Style x:Key="QsmHint" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.72"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="QsmOptionRow" TargetType="Grid">
        <Setter Property="Margin" Value="14,2,0,2"/>
    </Style>

    <DataTemplate x:Key="QualitySessionMeter_Options_Polished">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource BackgroundBrush}">
            <StackPanel Margin="8,4,24,22" MaxWidth="980" ToolTipService.ShowDuration="30000">

                <TextBlock Text="Options" Style="{StaticResource QsmSectionHeader}" Margin="0,2,0,5"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,8"/>

                <TextBlock Text="General" Style="{StaticResource QsmSubHeader}"/>
                <Grid Style="{StaticResource QsmOptionRow}" ToolTip="Master switch for QSM analysis and sequence-control integration.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable QualitySessionMeter" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.Enabled}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}" ToolTip="Choose which LIGHT frames QSM monitors. File actions remain provenance-gated for safety.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Monitoring Scope" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.MonitoringScopeIndex}" Width="238" HorizontalAlignment="Left">
                        <ComboBoxItem Content="QSM Controlled Blocks Only"/>
                        <ComboBoxItem Content="Advanced Sequencer LIGHTs"/>
                        <ComboBoxItem Content="All LIGHTs"/>
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}" ToolTip="Analyze and report normally, but suppress rename/move actions for rejected frames.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Monitor Only" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.MonitorOnly}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Baseline Window" VerticalAlignment="Center" ToolTip="Maximum recent clean samples retained per target/filter/exposure/gain/binning/camera context."/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.BaselineWindow, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum Learning Frames" VerticalAlignment="Center" ToolTip="Clean same-context samples required before image-signal baselines are mature."/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MinimumLearningFrames, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Guiding" Style="{StaticResource QsmSubHeader}"/>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject on Exposure RMS" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableGuideRms}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum RMS" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxGuideRms, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Sustained Excursion" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableSustainedExcursion}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Excursion Threshold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionThreshold, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Minimum Excursion Duration" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.ExcursionMinimumDuration, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Hard Excursion" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableHardExcursion}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Hard Excursion" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.HardExcursionThreshold, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="arcsec" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Image Signal" Style="{StaticResource QsmSubHeader}"/>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Relative Star Loss" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableStarCount}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Star Loss" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxStarLossPercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Background Deviation" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnableBackground}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Background Increase" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundIncreasePercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum Background Decrease" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.MaxBackgroundDecreasePercent, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Quality &amp; Session Intelligence" Style="{StaticResource QsmSubHeader}"/>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Worst Metric Weight" VerticalAlignment="Center" ToolTip="Affects the displayed 0–100 Quality Score only; hard reject rules remain independent."/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.WorstMetricWeight, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="0.50–0.95" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Rejected File Action" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Settings.RejectedFileActionIndex}" Width="238" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Keep in Place"/>
                        <ComboBoxItem Content="Prefix BAD_"/>
                        <ComboBoxItem Content="Move to Rejected Folder"/>
                    </ComboBox>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Predictive Warnings" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.PredictiveWarningsEnabled}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Environmental Correlation" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.EnvironmentalCorrelationEnabled}" HorizontalAlignment="Left"/>
                </Grid>

                <TextBlock Text="Smart Recovery" Style="{StaticResource QsmSubHeader}"/>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable Smart Recovery" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.SmartPauseEnabled}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Reject Streak" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartPauseRejectStreak, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="frames" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Pause Duration" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartPauseSeconds, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Healthy Guide Checks to Resume" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.SmartResumeHealthyGuideChecks, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="checks" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>

                <TextBlock Text="Web Dashboard" Style="{StaticResource QsmSubHeader}"/>
                <Grid Style="{StaticResource QsmOptionRow}" ToolTip="Starts the read-only browser dashboard on this N.I.N.A. computer. Reachability from outside your LAN depends on your VPN/reverse proxy/network setup.">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Enable Web Dashboard" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardEnabled}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Port" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Settings.WebDashboardPort, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="default 18974" VerticalAlignment="Center" Opacity="0.72"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Dashboard Address" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding WebDashboardAddress, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True" Width="350" HorizontalAlignment="Left"/>
                    <Button Grid.Column="2" Content="Copy" Click="CopyDashboardAddress" Width="72" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Status" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding WebDashboardStatus}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Require Password" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Settings.WebDashboardRequirePassword}" HorizontalAlignment="Left"/>
                </Grid>
                <Grid Style="{StaticResource QsmOptionRow}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Password" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" Width="238" HorizontalAlignment="Left" LostKeyboardFocus="DashboardPasswordLostFocus" ToolTip="Type a new password and leave the field to save it. No password is required unless Require Password is enabled."/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="{Binding Settings.WebDashboardPasswordStatus}" VerticalAlignment="Center" Opacity="0.72" Margin="8,0,8,0"/>
                        <Button Content="Clear" Click="ClearDashboardPassword" Width="64"/>
                    </StackPanel>
                </Grid>
                <TextBlock Margin="14,6,0,0" Style="{StaticResource QsmHint}" Text="The dashboard is read-only. QSM does not open router ports or expose itself to the Internet automatically. Use your existing LAN, VPN or HTTPS reverse proxy as appropriate."/>

                <TextBlock Text="Description" Style="{StaticResource QsmSectionHeader}"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="14,0,0,0" TextWrapping="Wrap" Text="QualitySessionMeter evaluates each LIGHT frame using exposure guiding, adaptive star-count/background baselines, temporal session intelligence and explicit hard rejection rules. Rejected images are never deleted."/>

                <TextBlock Text="Features" Style="{StaticResource QsmSectionHeader}"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="14,0,0,0" TextWrapping="Wrap" Text="• Real-time Quality and Confidence scores&#x0a;• Exposure-specific guiding RMS and excursion analysis&#x0a;• Rolling same-context star/background baselines&#x0a;• Reversible rejected-file handling with provenance safety&#x0a;• Session events, predictive warnings and reporting&#x0a;• Valid Frame Target / Smart Recovery sequencer integration&#x0a;• Read-only local Web Dashboard for phone/tablet monitoring"/>

                <TextBlock Text="Getting Help" Style="{StaticResource QsmSectionHeader}"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,0,0,10"/>
                <TextBlock Margin="14,0,0,0" TextWrapping="Wrap" Text="Repository and issue tracker: github.com/astropuzzo/QualitySessionMeter"/>
                <TextBlock Margin="14,5,0,0" Style="{StaticResource QsmHint}" Text="Current pre-store field-test builds include Synthetic Lab for validation. The future public N.I.N.A. store package excludes Synthetic Lab."/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>