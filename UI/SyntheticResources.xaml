<ResourceDictionary
    x:Class="NINA.Plugin.QualitySessionMeter.UI.SyntheticResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="LabCard" Color="#171A20"/>
    <SolidColorBrush x:Key="LabBorder" Color="#2A3039"/>
    <SolidColorBrush x:Key="LabText" Color="#F1F3F4"/>
    <SolidColorBrush x:Key="LabMuted" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="LabAccent" Color="#8AB4F8"/>
    <SolidColorBrush x:Key="LabSafe" Color="#81C995"/>
    <SolidColorBrush x:Key="LabWarn" Color="#FDD663"/>
<DataTemplate x:Key="NINA.Plugin.QualitySessionMeter.UI.SyntheticLabDockable_Dockable">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Loaded="SyntheticRootLoaded">
            <StackPanel Margin="8">
                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="QSM SYNTHETIC LAB" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource LabText}"/>
                        <TextBlock Text="Development / pre-release test harness inside N.I.N.A." Foreground="{StaticResource LabMuted}" Margin="0,3,0,10"/>
                        <Border Background="#10251A" BorderBrush="#285A3A" BorderThickness="1" CornerRadius="6" Padding="8">
                            <TextBlock Text="{Binding SafetyText}" Foreground="{StaticResource LabSafe}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="SYNTHETIC NIGHT PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabMuted}"/>
                        <ComboBox ItemsSource="{Binding Scenarios}"
                                  SelectedItem="{Binding SelectedScenario}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanRun}"
                                  Margin="0,6,0,8"
                                  MinWidth="260"/>
                        <TextBlock Text="{Binding ScenarioDescription}" Foreground="{StaticResource LabText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ScenarioExpectedSummary}" Foreground="{StaticResource LabAccent}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SELF-TEST STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabMuted}"/>
                            <TextBlock Text="{Binding Status}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource LabAccent}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Progress, StringFormat=Progress: {0}}" Foreground="{StaticResource LabText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" Width="120">
                            <TextBlock Text="FRAME DELAY (ms)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabMuted}"/>
                            <TextBox Text="{Binding FrameDelayMs, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0"/>
                            <TextBlock Text="0 = instant; 150 = visual" FontSize="10" Foreground="{StaticResource LabMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="RUNNING PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabMuted}"/>
                        <TextBlock Text="{Binding RunningScenario}" FontSize="15" Foreground="{StaticResource LabAccent}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <TextBlock Text="CURRENT FRAME SCENARIO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabMuted}"/>
                        <TextBlock Text="{Binding LastScenario}" FontSize="15" Foreground="{StaticResource LabText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <TextBlock Text="VERDICT DETAILS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabMuted}"/>
                        <TextBlock Text="{Binding FailureSummary}" Foreground="{StaticResource LabText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="AVAILABLE PROFILES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource LabMuted}" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource LabText}" TextWrapping="Wrap">
                            <Run Text="• Canonical regression — every V1 rule / baseline edge case&#10;"/>
                            <Run Text="• Excellent night — stable, high-quality sequence&#10;"/>
                            <Run Text="• Average night — normal variation, warnings and occasional rejects&#10;"/>
                            <Run Text="• Poor night — frequent wind/cloud/background failures&#10;"/>
                            <Run Text="• Severe / disaster night — repeated major failures&#10;"/>
                            <Run Text="• Deterioration + recovery — quality trend down, collapse, recovery"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Run selected scenario" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" Margin="4" Padding="12,5"/>
                            <Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="4" Padding="12,5"/>
                            <Button Content="Open synthetic folder" Command="{Binding OpenFolderCommand}" Margin="4" Padding="12,5"/>
                            <Button Content="Return to Live" Command="{Binding ReturnLiveCommand}" IsEnabled="{Binding CanReturnLive}" Margin="4" Padding="12,5"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding SessionFolder}" Foreground="{StaticResource LabMuted}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
