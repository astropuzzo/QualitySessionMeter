<ResourceDictionary
    x:Class="NINA.Plugin.QualitySessionMeter.UI.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.QualitySessionMeter.UI">

    <GeometryGroup x:Key="QSM_MeterSVG">
        <EllipseGeometry Center="32,32" RadiusX="29" RadiusY="29"/>
        <PathGeometry Figures="M 10,38 C 16,19 28,13 32,13 C 42,13 51,22 55,35"/>
        <PathGeometry Figures="M 32,32 L 47,22"/>
    </GeometryGroup>

    <SolidColorBrush x:Key="QsmCard" Color="#171A20"/>
    <SolidColorBrush x:Key="QsmCardBorder" Color="#2A3039"/>
    <SolidColorBrush x:Key="QsmPrimaryText" Color="#F1F3F4"/>
    <SolidColorBrush x:Key="QsmSecondaryText" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="QsmAccent" Color="#8AB4F8"/>

    <DataTemplate x:Key="NINA.Plugin.QualitySessionMeter.UI.QualitySessionMeterDockable_Dockable">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Loaded="DockableLoaded">
            <StackPanel Margin="6">
                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="QUALITY" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Text="{Binding CurrentFrame.QualityText, TargetNullValue=—}" FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource QsmPrimaryText}"/>
                            <TextBlock Text="{Binding CurrentFrame.QualityLabel, TargetNullValue=Waiting for frame}" Foreground="{StaticResource QsmAccent}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="CONFIDENCE" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Text="{Binding CurrentFrame.ConfidenceText, TargetNullValue=—}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource QsmPrimaryText}"/>
                            <TextBlock Text="{Binding CurrentFrame.ConfidenceLabel, TargetNullValue=Waiting}" Foreground="{StaticResource QsmAccent}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock Text="{Binding ModeText}" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Text="{Binding CurrentFrame.StatusText, TargetNullValue=IDLE}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource QsmPrimaryText}"/>
                            <TextBlock Text="{Binding CurrentFrame.ProbableCause, TargetNullValue=Waiting for first LIGHT frame}" Foreground="{StaticResource QsmSecondaryText}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding CurrentFrame.ReasonText}" Foreground="{StaticResource QsmSecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding CurrentFrame.ConfidenceReason}" Foreground="{StaticResource QsmSecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" FontStyle="Italic"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GUIDE RMS" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Text="{Binding CurrentFrame.GuideRmsText, TargetNullValue=N/A}" FontSize="16"/>
                            <TextBlock Text="{Binding CurrentFrame.ExcursionText}" Foreground="{StaticResource QsmSecondaryText}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GUIDE PATTERN" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Text="{Binding CurrentFrame.GuidePatternText, TargetNullValue=N/A}" FontSize="14" FontWeight="SemiBold" ToolTip="{Binding CurrentFrame.GuidePatternDetail}"/>
                            <TextBlock Text="{Binding CurrentFrame.GuidePatternConfidenceText}" Foreground="{StaticResource QsmSecondaryText}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STARS" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CurrentFrame.StarsText, TargetNullValue=N/A}" FontSize="16"/><TextBlock Text="{Binding CurrentFrame.StarDeltaText}" Margin="6,2,0,0" Foreground="{StaticResource QsmSecondaryText}"/></StackPanel>
                            <TextBlock Text="{Binding CurrentFrame.StarTrendResidualText}" Foreground="{StaticResource QsmSecondaryText}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="BACKGROUND" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CurrentFrame.BackgroundText, TargetNullValue=N/A}" FontSize="16"/><TextBlock Text="{Binding CurrentFrame.BackgroundDeltaText}" Margin="6,2,0,0" Foreground="{StaticResource QsmSecondaryText}"/></StackPanel>
                            <TextBlock Text="{Binding CurrentFrame.BackgroundTrendResidualText}" Foreground="{StaticResource QsmSecondaryText}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TEMPORAL" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Text="{Binding CurrentFrame.TrendText, TargetNullValue=N/A}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EventCount, StringFormat={}{0} session events}" Foreground="{StaticResource QsmSecondaryText}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="CAPTURED" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding Captured}" FontSize="16"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="USABLE" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding Usable}" FontSize="16"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="REJECTED" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding Rejected}" FontSize="16"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="ACCEPTANCE" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding AcceptanceRate, StringFormat={}{0:0.0}%}" FontSize="16"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="SESSION QUALITY" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding SessionQuality, StringFormat={}{0:0}}" FontSize="16"/></StackPanel>
                        <StackPanel Grid.Column="5"><TextBlock Text="SESSION CONF." Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/><TextBlock Text="{Binding SessionConfidence, StringFormat={}{0:0}%}" FontSize="16"/></StackPanel>
                    </Grid>
                </Border>

                <Border Visibility="{Binding CalibrationSuggestionVisibility}"
                        Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ADAPTIVE CALIBRATION SUGGESTION" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock Text="{Binding CalibrationStatus}" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CalibrationValues}" Foreground="{StaticResource QsmSecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Content="Apply" Command="{Binding ApplyCalibrationCommand}" IsEnabled="{Binding CalibrationAvailable}" Margin="0,0,6,0" Padding="10,4" ToolTip="Apply the currently proposed bounded thresholds. Configuration of Adaptive Calibration remains in Plugin Options."/>
                            <Button Content="Ignore" Command="{Binding IgnoreCalibrationCommand}" IsEnabled="{Binding CalibrationAvailable}" Padding="10,4" ToolTip="Dismiss this proposal for the current imaging context."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid Height="270">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="MULTICHANNEL TIMELINE — live values, rolling baseline and active reject limits" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                        <TextBlock Grid.Row="1" Margin="0,0,0,4" Foreground="{StaticResource QsmSecondaryText}" FontSize="10" Text="Dashed 0% = rolling clean-frame baseline · dashed colored lines = current limits · hover anywhere in the plot for exact frame/baseline values."/>
                        <local:QualityTimelineControl Grid.Row="2"
                                                      ItemsSource="{Binding Frames}"
                                                      MaxGuideRms="{Binding Settings.MaxGuideRms}"
                                                      MaxStarLossPercent="{Binding Settings.MaxStarLossPercent}"
                                                      MaxBackgroundIncreasePercent="{Binding Settings.MaxBackgroundIncreasePercent}"
                                                      MaxBackgroundDecreasePercent="{Binding Settings.MaxBackgroundDecreasePercent}"
                                                      EnableGuideRms="{Binding Settings.EnableGuideRms}"
                                                      EnableStarCount="{Binding Settings.EnableStarCount}"
                                                      EnableBackground="{Binding Settings.EnableBackground}"
                                                      Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                        <TextBlock Text="SESSION EVENTS — latest 12" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Event" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeRangeText}" Width="90"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="170"/>
                                <DataGridTextColumn Header="Frames" Binding="{Binding AffectedFrames}" Width="62"/>
                                <DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceText}" Width="65"/>
                                <DataGridTextColumn Header="Severity" Binding="{Binding SeverityText}" Width="75"/>
                                <DataGridTextColumn Header="Primary cause" Binding="{Binding PrimaryCause}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="125"/></Grid.RowDefinitions>
                            <TextBlock Text="BEST ACCEPTED" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding BestAccepted}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding FrameIndex}" Width="42"/><DataGridTextColumn Header="Quality" Binding="{Binding QualityText}" Width="62"/><DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceText}" Width="62"/><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="125"/></Grid.RowDefinitions>
                            <TextBlock Text="WORST ACCEPTED" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding WorstAccepted}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding FrameIndex}" Width="42"/><DataGridTextColumn Header="Quality" Binding="{Binding QualityText}" Width="62"/><DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceText}" Width="62"/><DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="REJECTED REVIEW — click a row to load the real FITS/XISF in N.I.N.A. Image" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                            <TextBlock DockPanel.Dock="Right" Text="Automatic verdict is preserved for audit" Foreground="{StaticResource QsmSecondaryText}" FontSize="10"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{Binding ReviewMessage}" Foreground="{StaticResource QsmSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding RejectedFrames}" SelectedItem="{Binding SelectedRejectedFrame, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding FrameIndex}" Width="42"/>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                                <DataGridTextColumn Header="File action" Binding="{Binding FileDispositionText}" Width="105"/>
                                <DataGridTextColumn Header="Q" Binding="{Binding QualityText}" Width="45"/>
                                <DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceText}" Width="60"/>
                                <DataGridTextColumn Header="RMS" Binding="{Binding GuideRmsText}" Width="66"/>
                                <DataGridTextColumn Header="Stars Δ" Binding="{Binding StarDeltaText}" Width="72"/>
                                <DataGridTextColumn Header="BG Δ" Binding="{Binding BackgroundDeltaText}" Width="72"/>
                                <DataGridTextColumn Header="Cause" Binding="{Binding ProbableCause}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="Selecting a real rejected file loads it for visual inspection; synthetic frames have no image file." Foreground="{StaticResource QsmSecondaryText}" FontSize="10" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="Open in N.I.N.A. Image" Command="{Binding OpenSelectedRejectedCommand}" IsEnabled="{Binding CanReviewSelectedRejected}" Margin="4,0" Padding="10,4"/>
                                <Button Content="Undo BAD / restore filename" Command="{Binding RestoreSelectedRejectedCommand}" IsEnabled="{Binding CanRestoreSelectedRejected}" Margin="4,0" Padding="10,4" ToolTip="Restores the physical file to its original name/location. The QSM automatic rejection remains recorded in session history and does not retroactively change sequencer accounting."/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                        <TextBlock Text="FRAME HISTORY" Foreground="{DynamicResource ButtonForegroundBrush}" Opacity="0.78" FontSize="11" FontWeight="SemiBold" TextAlignment="Left"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Frames}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding FrameIndex}" Width="42"/>
                                <DataGridTextColumn Header="Q" Binding="{Binding QualityText}" Width="45"/>
                                <DataGridTextColumn Header="Conf." Binding="{Binding ConfidenceText}" Width="58"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="88"/>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="180"/>
                                <DataGridTextColumn Header="RMS" Binding="{Binding GuideRmsText}" Width="65"/>
                                <DataGridTextColumn Header="Pattern" Binding="{Binding GuidePatternText}" Width="110"/>
                                <DataGridTextColumn Header="Trend" Binding="{Binding TrendText}" Width="68"/>
                                <DataGridTextColumn Header="Stars Δ" Binding="{Binding StarDeltaText}" Width="70"/>
                                <DataGridTextColumn Header="BG Δ" Binding="{Binding BackgroundDeltaText}" Width="70"/>
                                <DataGridTextColumn Header="Cause" Binding="{Binding ProbableCause}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SecondaryBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Open HTML report" Command="{Binding OpenReportCommand}" Margin="4,0" Padding="10,4"/>
                            <Button Content="Open session folder" Command="{Binding OpenSessionFolderCommand}" Margin="4,0" Padding="10,4"/>
                            <Button Content="Reset session" Command="{Binding ResetSessionCommand}" Margin="4,0" Padding="10,4"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SessionFolder}" Foreground="{StaticResource QsmSecondaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
